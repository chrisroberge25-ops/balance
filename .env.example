# Local SQLite. Works for `npm run dev` on one machine. Production uses Neon Postgres.
DATABASE_URL="file:./dev.db"

# Production (already set on Vercel by the linked Neon store):
# DATABASE_URL="postgresql://...-pooler....neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://....neon.tech/neondb?sslmode=require"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Calendar OAuth. Leave blank to use the in-app stub and paste-sync.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/google/callback"

# Stripe. Leave blank to use the local upgrade stub (no charge).
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO=""
