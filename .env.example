# Local SQLite. Works for `npm run dev` on one machine. Do not use this on Vercel.
DATABASE_URL="file:./dev.db"

# Hosted Postgres (Neon free tier). Required in production. Replace the file URL above.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"
# Neon’s Vercel integration sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct).
# DIRECT_URL is optional when DATABASE_URL_UNPOOLED is present.

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Calendar OAuth. Leave blank to use the in-app stub and paste-sync.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/google/callback"

# Stripe. Leave blank to use the local upgrade stub (no charge).
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO=""
